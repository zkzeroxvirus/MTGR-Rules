        "crypt",
        "run-success",
        "run-failure"
      ]
    },
    {
      "id": "between-runs",
      "number": "05",
      "title": "Between Runs",
      "description": "Understand persistent progression and what follows players into future runs.",
      "rules": [
        "host-types-profiles",
        "progression-reference"
      ]
    }
  ],
  "guides": [
    {
      "id": "encounter-won",
      "title": "We won an encounter",
      "description": "Resolve victory cleanly and continue the run.",
      "steps": [
        {
          "label": "Resolve XP, Cashout, and Loot Pool",
          "rule": "reward-timing"
        },
        {
          "label": "Choose Town or Stay Out",
          "rule": "post-encounter-choice"
        },
        {
          "label": "Resolve the selected path",
          "choices": [
            "town-flow",
            "stay-out-flow"
          ]
        },
        {
          "label": "Resolve Event(s), then begin the next encounter",
          "rule": "event-resolution"
        }
      ]
    },
    {
      "id": "encounter-lost",
      "title": "We lost an encounter",
      "description": "Apply the failed-encounter transition without ending the run.",
      "steps": [
        {
          "label": "Skip encounter rewards",
          "rule": "failed-encounter"
        },
        {
          "label": "Choose Town or Stay Out",
          "rule": "post-encounter-choice"
        },
        {
          "label": "Resolve the selected path",
          "choices": [
            "town-flow",
            "stay-out-flow"
          ]
        },
        {
          "label": "Continue normal Event resolution",
          "rule": "event-resolution"
        }
      ]
    },
    {
      "id": "going-to-town",
      "title": "We chose Town",
      "description": "Walk through a Town visit in order.",
      "steps": [
        {
          "label": "Fully heal all players",
          "rule": "town-flow"
        },
        {
          "label": "Use Town buildings",
          "rule": "town-buildings"
        },
        {
          "label": "Proceed to Event resolution",
          "rule": "event-resolution"
        }
      ]
    },
    {
      "id": "staying-out",
      "title": "We chose Stay Out",
      "description": "Resolve the higher-variance path in order.",
      "steps": [
        {
          "label": "Gain Stay Out XP",
          "rule": "stay-out-flow"
        },
        {
          "label": "Gain Mystery Packs",
          "rule": "stay-out-flow"
        },
        {
          "label": "Resolve Supply Drop and Wanderer",
          "rule": "stay-out-flow"
        },
        {
          "label": "Resolve the increased Event count",
          "rule": "event-resolution"
        }
      ]
    },
    {
      "id": "host-setup",
      "title": "Set up Host scaling",
      "description": "Find the Host scaling layers that apply at the start of an encounter.",
      "steps": [
        {
          "label": "Determine Authority level",
          "rule": "authority-level"
        },
        {
          "label": "Set up Doom cards",
          "rule": "doom-setup"
        },
        {
          "label": "Apply always-on scaling powers",
          "rule": "always-on-scaling"
        },
        {
          "label": "Apply encounter Affixes",
          "rule": "affixes-reference"
        }
      ]
    }
  ],
