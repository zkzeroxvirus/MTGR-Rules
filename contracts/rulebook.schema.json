{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/rulebook.schema.json",
  "title": "MTGR Rulebook Contract",
  "type": "object",
  "required": ["schemaVersion", "repository", "branch", "learnPath", "guides", "rules"],
  "properties": {
    "schemaVersion": {"const": 2},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "documents": {"type": "array", "items": {"type": "object", "required": ["id", "title", "source", "audience"]}},
    "learnPath": {"type": "array"},
    "guides": {"type": "array"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "phase", "audience", "content"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "source": {"type": "string", "pattern": "\\.md$"},
          "phase": {"enum": ["before-run", "encounter-loop", "between-encounters", "crypt", "between-runs"]},
          "audience": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["player", "host"]}},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "related": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "surfaces": {"type": "array", "uniqueItems": true, "items": {"enum": ["web", "notebook", "host"]}},
          "content": {
            "oneOf": [
              {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "document"}}, "additionalProperties": false},
              {"type": "object", "required": ["kind", "heading"], "properties": {"kind": {"const": "section"}, "heading": {"type": "string", "minLength": 1}}, "additionalProperties": false},
              {"type": "object", "required": ["kind", "heading", "endHeading"], "properties": {"kind": {"const": "range"}, "heading": {"type": "string", "minLength": 1}, "endHeading": {"type": "string", "minLength": 1}}, "additionalProperties": false}
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
